# 이 파일을 .env 로 복사해서 값을 바꾸세요. API 키·비밀번호는 코드가 아니라 여기에만 둡니다.
# (.env 는 git 에 올라가지 않습니다)

# 데이터 폴더 (DB, 이미지, 백업). 비우면 프로젝트의 data 폴더
# AIS_DATA_DIR=D:\AI인플루언서_MCP\data

# 언어 모델: auto | ollama | template
AIS_LLM_PROVIDER=auto
AIS_OLLAMA_URL=http://localhost:11434
AIS_OLLAMA_MODEL=qwen2.5-coder:7b
# GPU 오류(예: "PTX was compiled with an unsupported toolchain")가 나면 0 으로 두어 CPU 로 실행 (느림)
AIS_OLLAMA_NUM_GPU=
AIS_LLM_TIMEOUT=600
# 한국어·베트남어 품질을 높이려면 다국어 모델을 받아서 지정하세요. 예) ollama pull qwen2.5:7b
# 의미 검색용 임베딩 모델 (비우면 내장 해시 임베딩). 예) ollama pull bge-m3
AIS_OLLAMA_EMBED_MODEL=

# 이미지: auto | comfyui | placeholder
AIS_IMAGE_PROVIDER=auto
AIS_COMFYUI_URL=http://127.0.0.1:8188
# AIS_COMFYUI_WORKFLOW=D:\AI인플루언서_MCP\config\comfyui_workflow.json

# 영상 합성용 FFmpeg (PATH 에 없으면 전체 경로)
AIS_FFMPEG=ffmpeg

# 자동화 정책
AIS_AGENT_APPROVE_STORIES=true
AIS_AGENT_APPROVE_CONTENT=false
AIS_AGENT_APPROVE_CHARACTER=false
AIS_DAILY_IMAGE_BUDGET=30

# 아카이브에 파일을 가져올 수 있는 추가 폴더 (세미콜론으로 구분)
# AIS_IMPORT_DIRS=D:\참조이미지;D:\촬영본

# 웹 대시보드
AIS_WEB_HOST=127.0.0.1
AIS_WEB_PORT=8765
# 설정하면 쓰기 요청에 X-Admin-Token 헤더가 필요합니다
AIS_ADMIN_TOKEN=
